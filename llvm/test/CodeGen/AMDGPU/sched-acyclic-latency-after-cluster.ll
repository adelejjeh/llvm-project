  %v2 = load <4 x i64>, ptr addrspace(1) %pm, align 32
  %sum2 = add <4 x i64> %v2, %acc2
  %i.next = add nuw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  %r0 = add <4 x i64> %sum0, %sum1
  %r1 = add <4 x i64> %sum2, %sum3
  %r = add <4 x i64> %r0, %r1
  %pout = getelementptr [32 x i8], ptr addrspace(1) %out, i64 %tid.ext
  store <4 x i64> %r, ptr addrspace(1) %pout, align 32
  ret void
}

declare i32 @llvm.amdgcn.workitem.id.x()
